# Application
APP_NAME=Vending Machine Service Control
DEBUG=true
SECRET_KEY=your-secret-key-here-change-in-production

# Database
DATABASE_URL=postgresql+asyncpg://vending_user:vending_pass@db:5432/vending
DB_ECHO=false

# Redis
REDIS_URL=redis://redis:6379/0

# S3 Storage (SeaweedFS, MinIO, AWS S3)
S3_ENDPOINT_URL=http://seaweedfs:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=vending-photos
S3_REGION=us-east-1

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhook

# Admin API Key (for admin panel authentication)
ADMIN_API_KEY=your-admin-api-key-change-in-production

# Frontend
VITE_API_URL=http://localhost:8000
VITE_MAP_CENTER_LAT=55.7558
VITE_MAP_CENTER_LNG=37.6173
VITE_MAP_ZOOM=10

# Scheduler
SCHEDULER_TIMEZONE=UTC

# Logging
LOG_LEVEL=INFO
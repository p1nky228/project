# ============================================
# PRODUCTION ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env.production and fill in your values
# NEVER commit .env.production to git!

# ----------------------------------------------------------------------
# DATABASE (Supabase - Transaction Pooler)
# ----------------------------------------------------------------------
# Format: postgresql+asyncpg://postgres:PASSWORD@db.PROJECT_REF.supabase.co:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:6543/postgres
DB_ECHO=false
DB_POOL_DISABLED=false

# ----------------------------------------------------------------------
# REDIS (Upstash)
# ----------------------------------------------------------------------
# Format: rediss://default:TOKEN@HOST.upstash.io:6379
REDIS_URL=rediss://default:YOUR_TOKEN@YOUR_HOST.upstash.io:6379

# ----------------------------------------------------------------------
# TELEGRAM BOT
# ----------------------------------------------------------------------
BOT_TOKEN=your_bot_token_from_botfather
# For production on Fly.io, use polling (no webhook needed)
BOT_USE_POLLING=true
# BOT_WEBHOOK_URL=https://your-app.fly.dev/webhook  # Only if using webhook
# BOT_PROXY=  # NOT NEEDED on Fly.io (Telegram accessible)

# ----------------------------------------------------------------------
# S3 STORAGE (Cloudflare R2)
# ----------------------------------------------------------------------
S3_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY=YOUR_R2_ACCESS_KEY_ID
S3_SECRET_KEY=YOUR_R2_SECRET_ACCESS_KEY
S3_BUCKET_NAME=vending-photos
S3_REGION=auto

# ----------------------------------------------------------------------
# SECURITY
# ----------------------------------------------------------------------
SECRET_KEY=generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Admin API Key for backend admin endpoints
ADMIN_API_KEY=generate-strong-random-key-64-chars

# ----------------------------------------------------------------------
# CORS (for frontend)
# ----------------------------------------------------------------------
# Add your frontend URL(s) here
CORS_ORIGINS=["https://your-frontend.vercel.app", "https://your-frontend.pages.dev"]

# ----------------------------------------------------------------------
# SCHEDULER
# ----------------------------------------------------------------------
SCHEDULER_TIMEZONE=Europe/Moscow

# ----------------------------------------------------------------------
# LOGGING
# ----------------------------------------------------------------------
LOG_LEVEL=INFO

# ----------------------------------------------------------------------
# FRONTEND (Vite)
# ----------------------------------------------------------------------
# These go in frontend/.env.production
# VITE_API_URL=https://your-app.fly.dev
# VITE_MAP_CENTER_LAT=55.7558
# VITE_MAP_CENTER_LNG=37.6173
# VITE_MAP_ZOOM=10
# Database
DATABASE_URL=postgresql+asyncpg://vending_user:vending_pass@localhost:5432/vending
DB_ECHO=true
DB_POOL_DISABLED=false

# Redis
REDIS_URL=redis://localhost:6379/0

# Telegram Bot
BOT_TOKEN=your_bot_token_here
BOT_WEBHOOK_URL=

# S3 Storage
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=vending-photos
S3_REGION=us-east-1

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=["*"]